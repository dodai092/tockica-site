#!/bin/sh
# Fast pre-commit gate. Full lint + Lighthouse + link check run in CI.
# Bypass with: git commit --no-verify

# Client-repo core guard: in a client site (no .template-repo marker), block commits
# that touch template core. See CLAUDE.md "Hard rules".
if [ ! -f .template-repo ]; then
  core=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^(src/layouts/|src/utils/|src/components/(ui|common|blog|widgets)/|vendor/|src/components/(Logo|Favicons|CustomStyles)\.astro$)') || true

  # astro.config.ts is mostly core, but SETUP.md B1c has every custom-typeface client
  # (the common case, not the exception) edit its `fonts:` array. A blanket block on the
  # whole file fights that documented, sanctioned step. Allow a staged astro.config.ts
  # change only if everything OUTSIDE the `fonts: [ ... ],` block is untouched; anything
  # else in the file (integrations, adapter, image config, ...) still blocks.
  if git diff --cached --name-only --diff-filter=ACMR | grep -qx 'astro.config.ts'; then
    strip_fonts() {
      awk '/^  fonts: \[$/ { skip = 1; next } skip && /^  \],$/ { skip = 0; next } skip { next } { print }'
    }
    if git cat-file -e HEAD:astro.config.ts 2>/dev/null; then
      old=$(git show HEAD:astro.config.ts | strip_fonts)
      new=$(git show :astro.config.ts | strip_fonts)
    else
      old=""
      new="x" # new file: nothing to compare against, always flag
    fi
    if [ "$old" != "$new" ]; then
      if [ -n "$core" ]; then
        core="$core
astro.config.ts"
      else
        core="astro.config.ts"
      fi
    fi
  fi

  if [ -n "$core" ]; then
    echo "x Commit touches template core (do not edit core during a client build):"
    echo "$core" | sed 's/^/    /'
    echo
    echo "  Per-client code goes in src/components/client/ and the brand.ts / config.yaml surfaces."
    echo "  astro.config.ts's fonts: [ ... ] array is the one sanctioned exception (SETUP.md B1c)."
    echo "  If core genuinely needs a change, raise it. To override: git commit --no-verify"
    exit 1
  fi
fi

npm run check:astro && npm run check:prettier
