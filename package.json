{
  "name": "tockica-site",
  "version": "0.1.0",
  "description": "Točkica na i website.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "init-client": "node scripts/init-client.mjs",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "npm run check:astro && npm run check:eslint && npm run check:prettier && npm run check:init",
    "check:astro": "astro check",
    "check:eslint": "eslint .",
    "check:prettier": "prettier --check .",
    "check:init": "node scripts/init-client.mjs --check",
    "fix": "npm run fix:eslint && npm run fix:prettier",
    "fix:eslint": "eslint --fix .",
    "fix:prettier": "prettier -w .",
    "test:quality": "node --test tests/*.test.mjs",
    "test:routes": "node scripts/check-quality-routes.mjs",
    "test:analytics": "node --test tests/analytics-events.browser.mjs",
    "test:meta": "node scripts/check-canonical-host.mjs",
    "test:baselines": "node scripts/check-baseline-presence.mjs",
    "test:contrast": "node --test tests/contrast.test.mjs",
    "test:lhci": "lhci autorun",
    "test:links": "linkinator ./dist --config linkinator.config.json",
    "screenshot": "node scripts/screenshot.mjs",
    "screenshot:check": "node scripts/screenshot.mjs --check",
    "verify": "npm run build && npm run check && npm run test:quality && npm run test:routes && npm run test:analytics && npm run test:meta && npm run test:baselines && npm run test:contrast && npm run test:links && npm run test:lhci && npm run screenshot:check",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@astro-community/astro-embed-twitter": "^0.5.11",
    "@astro-community/astro-embed-vimeo": "^0.3.12",
    "@astro-community/astro-embed-youtube": "^0.5.10",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.9",
    "astro-icon": "^1.1.5",
    "astro-og-canvas": "^0.13.1",
    "astro-seo": "^1.2.0",
    "limax": "4.2.3",
    "lodash.merge": "^4.6.2",
    "unpic": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/partytown": "^2.1.9",
    "@eslint/js": "^10.0.1",
    "@iconify-json/flat-color-icons": "^1.2.3",
    "@iconify-json/tabler": "^1.2.43",
    "@lhci/cli": "0.15.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash.merge": "^4.6.9",
    "@types/mdx": "^2.0.14",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "astro-compress": "^2.4.3",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "js-yaml": "^5.5.0",
    "linkinator": "^8.1.0",
    "mdast-util-to-string": "^4.0.0",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "reading-time": "^1.5.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "yaml": ">=2.8.3",
    "astro-compress": {
      "sharp": "^0.35.3",
      "svgo": "^4.0.2"
    },
    "postcss": {
      "nanoid": "^3.3.18"
    }
  }
}
