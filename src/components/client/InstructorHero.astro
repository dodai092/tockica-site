---
// The top of an instructor's page: a lit slate band with the text on the left and the cutout standing on the band's bottom
// edge, no frame (the photos end at the torso, so they sit there naturally). The photo is placed by the face. Below md the
// text comes first and the photo under it. Without a photo file the band holds the usual Photo placeholder instead.
import { Picture } from 'astro:assets';
import Photo from '~/components/client/Photo.astro';
import { faceOf, photoOf } from '~/lib/instructor-photo';

interface Props {
  slug: string;
  first: string;
  /** The placeholder's label (copy.photo.instructor). */
  role: string;
}

const { slug, first, role } = Astro.props;
const photo = photoOf(slug);
const [fx] = faceOf(slug);
---

<div
  data-photo={photo ? `instructor-${slug}` : undefined}
  class="hero-band relative isolate overflow-hidden rounded-(--aw-radius-card) px-5 pt-6 sm:px-8 md:min-h-[26rem] md:px-10 md:pt-10"
>
  <div class="relative z-10 flex flex-col gap-4 md:max-w-[50%] md:pb-10">
    <slot />
  </div>
  {
    photo ? (
      <div class="relative mt-6 h-[22rem] md:absolute md:inset-0 md:mt-0 md:h-auto">
        <Picture
          src={photo}
          alt={first}
          formats={['avif', 'webp']}
          widths={[480, 800]}
          sizes="(min-width: 768px) 30rem, 90vw"
          class="face-photo absolute bottom-0 left-1/2 w-auto max-w-none"
          style={`transform: translateX(-${fx}%)`}
        />
      </div>
    ) : (
      <div class="relative z-10 mt-6 md:absolute md:bottom-6 md:right-10 md:mt-0 md:w-56">
        <Photo role={role} ratio="3 / 4" />
      </div>
    )
  }
  <div class="pointer-events-none absolute inset-x-0 bottom-0 z-[1] h-[18%] fade"></div>
</div>

<style>
  .hero-band {
    background: radial-gradient(
      ellipse 80% 70% at 50% 75%,
      color-mix(in srgb, var(--aw-color-accent) 60%, white),
      var(--aw-color-accent) 50%,
      color-mix(in srgb, var(--aw-color-accent) 70%, black)
    );
  }
  .fade {
    background: linear-gradient(to top, var(--aw-color-bg-page), transparent);
  }
  .face-photo {
    height: 100%;
  }
  @media (min-width: 768px) {
    .hero-band {
      background: radial-gradient(
        ellipse 60% 90% at 72% 40%,
        color-mix(in srgb, var(--aw-color-accent) 60%, white),
        var(--aw-color-accent) 50%,
        color-mix(in srgb, var(--aw-color-accent) 70%, black)
      );
    }
    .face-photo {
      left: 72%;
      height: min(92%, 34rem);
    }
  }
</style>
