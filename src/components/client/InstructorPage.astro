---
// One instructor: portrait, line, bio, what they teach, their Spotify playlist and their next classes. Bio, playlist
// and portrait are Placeholders until Dunia sends them. The classes come from the mock schedule, like the rest of the
// site until the booking app's feed exists.
import Page from '~/components/client/Page.astro';
import Photo from '~/components/client/Photo.astro';
import Placeholder from '~/components/client/Placeholder.astro';
import PlaylistEmbed from '~/components/client/PlaylistEmbed.astro';
import ScheduleRow from '~/components/client/schedule/ScheduleRow.astro';
import { instructors } from '~/data/instructors';
import { buildMockSchedule } from '~/lib/mock-schedule';
import { firstFreeBike, parseSchedule } from '~/lib/schedule-feed';
import { seatNote, seatState } from '~/lib/seats';
import { getCopy, instructorPath, pathFor } from '~/i18n';
import type { Lang } from '~/i18n';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const copy = getCopy(lang);
const t = copy.instructorPage;
const i = instructors.find((x) => x.slug === slug)!;
const line = i.line[lang];
const bio = i.bio?.[lang] ?? null;

const now = new Date();
const mine = (parseSchedule({ classes: buildMockSchedule(now) }, now, 1000)?.classes ?? []).filter(
  (c) => c.instructor === i.first
);
const upcoming = mine.slice(0, 4);
const teaches = [...new Set(mine.map((c) => c.name))];
const seatCopy = copy.schedulePage.seats;
const labels = { book: copy.home.nextClasses.book, waitlist: copy.home.nextClasses.waitlist };
const dayOf = new Intl.DateTimeFormat(lang, { weekday: 'short', timeZone: 'Europe/Zagreb' });
const timeOf = new Intl.DateTimeFormat(lang, {
  hour: '2-digit',
  minute: '2-digit',
  hourCycle: 'h23',
  timeZone: 'Europe/Zagreb',
});
const twin = { hr: instructorPath(slug, 'hr'), en: instructorPath(slug, 'en') };
---

<Page
  lang={lang}
  route="instructors"
  title={i.first}
  description={line ?? copy.instructorsPage.description}
  twin={twin}
>
  <section class="mx-auto max-w-7xl px-4 sm:px-6 py-12 md:py-16" data-instructor-page={slug}>
    <a href={pathFor('instructors', lang)} class="text-sm font-semibold text-link underline">{t.back}</a>
    <div class="mt-6 grid gap-8 md:grid-cols-[18rem_1fr] md:gap-12">
      <Photo role={copy.home.photo.instructor} ratio="3 / 4" />
      <div class="flex flex-col gap-4">
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-heading">{i.first}</h1>
        <p class="text-xl text-default">
          {line ?? <Placeholder lang={lang} label={`${i.first} line (doc item 4)`} />}
        </p>
        <p class="max-w-prose text-default">
          {bio ?? <Placeholder lang={lang} label={`${i.first} bio, a few sentences (Dunia doc item 1)`} />}
        </p>
        {
          teaches.length > 0 && (
            <p class="text-default">
              <span class="font-semibold text-heading">{t.teaches}:</span> {teaches.join(', ')}
            </p>
          )
        }
      </div>
    </div>

    <h2 class="mt-12 text-2xl font-bold text-heading">{t.playlist}</h2>
    <div class="mt-4">
      <PlaylistEmbed lang={lang} first={i.first} playlist={i.playlist ?? null} />
    </div>

    <h2 class="mt-12 text-2xl font-bold text-heading">{t.nextClasses}</h2>
    <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        upcoming.map((c) => {
          const free = c.capacity - c.takenBikes.length;
          const st = seatState(free, c.capacity);
          return (
            <ScheduleRow
              card
              id={c.id}
              freeBikes={c.freeBikes}
              day={dayOf.format(new Date(c.startsAt))}
              time={timeOf.format(new Date(c.startsAt))}
              instructor={c.instructor}
              plainInstructor
              name={c.themeName ?? c.name}
              seatsText={seatNote(free, c.capacity, seatCopy, lang)}
              scarce={st.scarce}
              full={firstFreeBike(c) === null}
              href={pathFor('schedule', lang)}
              labels={labels}
            />
          );
        })
      }
    </ul>
    <p class="mt-4">
      <Placeholder lang={lang} label="next classes are mock data until the booking app endpoint exists" />
    </p>
  </section>
</Page>
