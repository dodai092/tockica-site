---
// Netlify form "sculpt-inquiry", pattern from docs/forms.md: honeypot, required privacy
// consent, action to our own thanks page. Recipient e-mail is set in Netlify, not here.
import Button from '~/components/ui/Button.astro';
import { getCopy, pathFor } from '~/i18n';
import type { Lang } from '~/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = getCopy(lang);
const field =
  'py-3 px-4 block w-full text-md rounded-(--aw-radius-card) border border-gray-200 dark:border-gray-700 bg-white dark:bg-page';
---

<div
  class="flex flex-col max-w-xl rounded-(--aw-radius-card) border border-gray-200 dark:border-gray-700 bg-white dark:bg-accent shadow-(--aw-shadow-card) p-4 sm:p-6 lg:p-8 w-full"
>
  <form
    name="sculpt-inquiry"
    method="POST"
    data-netlify="true"
    netlify-honeypot="bot-field"
    action={pathFor('thanks', lang)}
  >
    <input type="hidden" name="form-name" value="sculpt-inquiry" />
    <p hidden><label>Do not fill this out: <input name="bot-field" /></label></p>

    <div class="mb-6">
      <label for="sculpt-name" class="block text-sm font-medium">{copy.form.name}</label>
      <input type="text" name="name" id="sculpt-name" required autocomplete="name" class={field} />
    </div>

    <div class="mb-6">
      <label for="sculpt-email" class="block text-sm font-medium">{copy.form.email}</label>
      <input type="email" name="email" id="sculpt-email" required autocomplete="email" class={field} />
    </div>

    <div>
      <label for="sculpt-message" class="block text-sm font-medium">{copy.form.message}</label>
      <textarea id="sculpt-message" name="message" rows={4} required class={field}></textarea>
    </div>

    <div class="mt-3 flex items-start">
      <div class="flex mt-0.5">
        <input id="sculpt-consent" name="consent" type="checkbox" required class="cursor-pointer mt-1" />
      </div>
      <div class="ml-3">
        <label for="sculpt-consent" class="cursor-pointer select-none text-sm text-muted">
          {copy.form.consentBefore}<a href={pathFor('privacy', lang)} class="underline">{copy.form.consentLink}</a>{
            copy.form.consentAfter
          }
        </label>
      </div>
    </div>

    <div class="mt-10 grid">
      <Button variant="primary" type="submit" text={copy.sculptPage.submit} />
    </div>
  </form>
</div>
