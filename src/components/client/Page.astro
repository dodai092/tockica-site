---
// Shell for every Točkica page: PageLayout with the client header and footer, language
// and hreflang from the route table, and the fixed mobile book bar.
import PageLayout from '~/layouts/PageLayout.astro';
import SiteHeader from '~/components/client/SiteHeader.astro';
import SiteFooter from '~/components/client/SiteFooter.astro';
import BookBar from '~/components/client/BookBar.astro';
import MotionStyles from '~/components/client/MotionStyles.astro';
import { bookBarEnabled } from '~/lib/book-bar';
import { alternatesFor } from '~/i18n';
import type { Lang, RouteKey } from '~/i18n';

interface Props {
  lang: Lang;
  route: RouteKey;
  title: string;
  description: string;
  noindex?: boolean;
  /** The waitlist thank-you page: the same header with only the logo and language switch, a footer without the site menu. */
  minimal?: boolean;
  /** The bar overlays the first section like the homepage, but follows the inner-page scroll rule (waitlist). */
  overlayBar?: boolean;
  /** For a page that is not in the route table, such as one instructor: its path in each language. */
  twin?: Record<Lang, string>;
}

const { lang, route, title, description, noindex = false, minimal = false, overlayBar = false, twin } = Astro.props;

const metadata = {
  title,
  description,
  lang,
  alternates: twin
    ? [
        { hreflang: 'hr', href: twin.hr },
        { hreflang: 'en', href: twin.en },
        { hreflang: 'x-default', href: twin.hr },
      ]
    : alternatesFor(route),
  ...(noindex ? { robots: { index: false, follow: false } } : {}),
};
// The schedule page is the booking entry, so it has no extra book bar. The footer gets
// bottom space so the fixed bar never covers its last line.
const showBookBar = bookBarEnabled && route !== 'schedule';
---

<PageLayout metadata={metadata}>
  <MotionStyles />
  <Fragment slot="announcement"></Fragment>
  <SiteHeader slot="header" lang={lang} route={route} twin={twin} minimal={minimal} pageScroll={overlayBar} />
  <slot />
  <Fragment slot="footer">
    <SiteFooter lang={lang} bookBarSpace={showBookBar} minimal={minimal} />
    {showBookBar && <BookBar lang={lang} />}
  </Fragment>
</PageLayout>
