---
import Button from '~/components/ui/Button.astro';
---

<!-- Netlify Forms reference. Wired for Netlify deploys. For another host, see docs/forms.md. -->
<div
  class="flex flex-col max-w-xl mx-auto rounded-(--aw-radius-card) backdrop-blur border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 shadow-(--aw-shadow-card) p-4 sm:p-6 lg:p-8 w-full"
>
  <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thank-you/">
    <input type="hidden" name="form-name" value="contact" />
    <p hidden><label>Do not fill this out: <input name="bot-field" /></label></p>

    <div class="mb-6">
      <label for="name" class="block text-sm font-medium">Name</label>
      <input
        type="text"
        name="name"
        id="name"
        required
        class="py-3 px-4 block w-full text-md rounded-(--aw-radius-card) border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
      />
    </div>

    <div class="mb-6">
      <label for="email" class="block text-sm font-medium">Email</label>
      <input
        type="email"
        name="email"
        id="email"
        required
        class="py-3 px-4 block w-full text-md rounded-(--aw-radius-card) border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
      />
    </div>

    <div>
      <label for="message" class="block text-sm font-medium">Message</label>
      <textarea
        id="message"
        name="message"
        rows={4}
        required
        class="py-3 px-4 block w-full text-md rounded-(--aw-radius-card) border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
      ></textarea>
    </div>

    <div class="mt-3 flex items-start">
      <div class="flex mt-0.5">
        <input id="consent" name="consent" type="checkbox" required class="cursor-pointer mt-1" />
      </div>
      <div class="ml-3">
        <label for="consent" class="cursor-pointer select-none text-sm text-gray-600 dark:text-gray-400">
          I agree to the <a href="/privacy" class="underline">privacy policy</a>.
        </label>
      </div>
    </div>

    <div class="mt-10 grid">
      <Button variant="primary" type="submit">Send message</Button>
    </div>
  </form>
</div>
