---
// The waitlist page (/waitlist): the offer, a sign-up form and the steps. The form is not connected to
// the booking database yet (placeholder flags below), so a LAUNCH build fails until it is.
import { Picture } from 'astro:assets';
import Button from '~/components/ui/Button.astro';
import Page from '~/components/client/Page.astro';
import Placeholder from '~/components/client/Placeholder.astro';
import HowItWorks from '~/components/client/home/HowItWorks.astro';
import wordsArt from '~/assets/images/hero-words.png';
import { getCopy, pathFor } from '~/i18n';
import type { Lang } from '~/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = getCopy(lang);
const t = copy.waitlist;
// The form card is white on the dark page so it is the brightest thing in view. Focus rings use the brand colour.
const field =
  'block w-full rounded-(--aw-radius-card) border border-gray-300 bg-white px-4 py-3 text-md text-slate-900 caret-primary transition-[border-color,box-shadow] duration-200 ease-in-out focus:border-primary aria-invalid:border-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-1';
---

<Page lang={lang} route="waitlist" title={t.title} description={t.description} overlayBar>
  <section data-section="hero" class="relative isolate overflow-hidden bg-black text-white">
    <Picture
      src={wordsArt}
      alt=""
      formats={['avif', 'webp']}
      widths={[768, 1280, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-20 h-full w-full object-cover object-[52%_40%]"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/70 via-black/15 to-black/0" aria-hidden="true"></div>
    <div class="absolute inset-x-0 bottom-0 -z-10 h-1/3 bg-gradient-to-b from-transparent to-black" aria-hidden="true">
    </div>
    <div
      class="mx-auto grid max-w-7xl grid-cols-[minmax(0,1fr)] gap-8 px-4 pb-12 pt-20 sm:px-6 md:grid-cols-2 md:items-start md:gap-10 md:pb-28 md:pt-36"
    >
      <div>
        <h1 class="text-3xl font-extrabold tracking-[-0.02em] text-balance md:text-5xl">{t.heading}</h1>
        <p class="mt-3 text-lg text-white/80">{t.offer}</p>
        <p class="mt-8 text-xl font-bold leading-snug text-balance md:mt-12 md:text-3xl">{t.priceLine}</p>
        <p
          class="font-heading text-[clamp(3.5rem,22vw,6rem)] font-extrabold leading-none tracking-[-0.03em] md:text-9xl"
        >
          {t.price}
        </p>
        <p class="mt-4 text-base text-balance text-white/85">{t.room}</p>
        <p class="mt-8 inline-block rounded-full bg-primary px-4 py-1.5 text-sm font-semibold text-white">
          {t.deadline}
        </p>
        <p class="mt-3 max-w-md text-base leading-6 text-white/85">{t.terms}</p>
      </div>

      <div class="w-full max-w-xl">
        <div
          id="waitlist-form"
          class="scroll-mt-6 rounded-(--aw-radius-card) bg-white p-5 text-slate-900 shadow-xl sm:p-6 lg:p-8"
        >
          <h2 class="text-2xl font-bold text-slate-900">{t.formHeading}</h2>
          <form
            class="mt-5"
            name="waitlist"
            novalidate
            method="POST"
            data-waitlist-form
            data-thanks={pathFor('waitlistThanks', lang)}
            data-errors={JSON.stringify(t.errors)}
          >
            <div class="mb-4">
              <label for="waitlist-name" class="block text-sm font-medium text-slate-700">{copy.form.name}</label>
              <input
                type="text"
                name="name"
                id="waitlist-name"
                required
                autocomplete="given-name"
                aria-describedby="waitlist-name-error"
                class={field}
              />
              <p class="mt-1 text-sm text-primary empty:mt-0" id="waitlist-name-error" data-error aria-live="polite">
              </p>
            </div>
            <div class="mb-4">
              <label for="waitlist-email" class="block text-sm font-medium text-slate-700">{copy.form.email}</label>
              <input
                type="email"
                name="email"
                id="waitlist-email"
                required
                autocomplete="email"
                aria-describedby="waitlist-email-error"
                class={field}
              />
              <p class="mt-1 text-sm text-primary empty:mt-0" id="waitlist-email-error" data-error aria-live="polite">
              </p>
            </div>
            <fieldset class="mb-4 min-w-0" data-birth aria-describedby="waitlist-birth-error">
              <legend class="block text-sm font-medium text-slate-700">{t.birthDate}</legend>
              <div class="mt-1 flex gap-3">
                {
                  (
                    [
                      ['day', t.birthParts.day, 2, 'flex-1', 'bday-day', t.birthHints.day],
                      ['month', t.birthParts.month, 2, 'flex-1', 'bday-month', t.birthHints.month],
                      ['year', t.birthParts.year, 4, 'flex-[1.5]', 'bday-year', t.birthHints.year],
                    ] as const
                  ).map(([key, label, len, width, ac, hint]) => (
                    <div class={`min-w-0 ${width}`}>
                      <label for={`waitlist-birth-${key}`} class="block text-xs text-slate-600">
                        {label}
                      </label>
                      <input
                        type="text"
                        inputmode="numeric"
                        id={`waitlist-birth-${key}`}
                        data-birth-part={key}
                        maxlength={len}
                        autocomplete={ac}
                        placeholder={hint}
                        aria-describedby="waitlist-birth-error"
                        class={[field, 'px-3 text-center'].join(' ')}
                      />
                    </div>
                  ))
                }
              </div>
              <input type="hidden" name="birthdate" data-birth-value />
              <p class="mt-1 text-sm text-primary empty:mt-0" id="waitlist-birth-error" data-error aria-live="polite">
              </p>
            </fieldset>
            <div class="mt-3 flex items-start gap-3">
              <input
                id="waitlist-consent"
                name="consent"
                type="checkbox"
                required
                aria-describedby="waitlist-consent-error"
                class="mt-3.5 h-5 w-5 flex-none cursor-pointer accent-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
              />
              <label for="waitlist-consent" class="cursor-pointer select-none py-3 text-sm leading-6 text-slate-600">
                {copy.form.consentBefore}<a href={pathFor('privacy', lang)} class="text-slate-900 underline">
                  {copy.form.consentLink}
                </a>{copy.form.consentAfter}
              </label>
            </div>
            <p class="mt-2 text-sm text-primary empty:mt-0" id="waitlist-consent-error" data-error aria-live="polite">
            </p>
            <div class="mt-6 grid">
              <Button variant="primary" type="submit" text={t.submit} />
            </div>
          </form>
        </div>
        {/* Developer flags for facts still missing. One block outside the card, so the form reads clean. */}
        <div class="mt-4 grid justify-items-start gap-2 text-sm">
          <Placeholder lang={lang} label={t.termsMissing} />
          <Placeholder lang={lang} label={t.birthDateWhyMissing} />
          <Placeholder lang={lang} label="waitlist form is not connected to the booking database" />
        </div>
      </div>
    </div>
  </section>

  <HowItWorks lang={lang} heading={t.stepsHeading} steps={t.steps} goalLast timeline={t.timeline} />

  <section class="relative isolate overflow-hidden bg-black text-white">
    <Picture
      src={wordsArt}
      alt=""
      formats={['avif', 'webp']}
      widths={[768, 1280, 1600]}
      sizes="100vw"
      loading="lazy"
      class="absolute inset-0 -z-20 h-full w-full origin-[88%_55%] scale-[1.6] md:scale-[1.9] object-cover object-[88%_55%]"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/70 via-black/20 to-black/0" aria-hidden="true"></div>
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-36">
      <p class="max-w-3xl font-heading text-3xl font-extrabold leading-tight tracking-tight text-balance md:text-6xl">
        {copy.home.about.line}
      </p>
      <p class="mt-6 max-w-xl text-lg font-semibold text-white/90 md:text-xl">
        {`${t.priceLine} ${t.price}. ${t.deadline}`}
      </p>
      <Button variant="primary" href="#waitlist-form" text={t.formHeading} class="mt-6 md:mt-8" data-to-form />
    </div>
  </section>
</Page>

<style>
  /* Submit is in flight: say so at once (80 ms press already scales it), and ignore a second tap. */
  [data-waitlist-form] :global(button[aria-busy='true']) {
    opacity: 0.7;
    pointer-events: none;
    transition: opacity 0.2s ease-in-out;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-waitlist-form]');
  const msg: Record<string, string> = JSON.parse(form?.dataset.errors ?? '{}');

  const field = (id: string) => document.getElementById(id) as HTMLInputElement;
  const parts = [...document.querySelectorAll<HTMLInputElement>('[data-birth-part]')];
  const birthValue = document.querySelector<HTMLInputElement>('[data-birth-value]');

  // Each check returns the error text, or '' when the field is fine.
  const checkName = () => (field('waitlist-name').value.trim() ? '' : msg.required);
  const checkEmail = () => {
    const el = field('waitlist-email');
    return !el.value.trim() ? msg.required : el.validity.typeMismatch ? msg.email : '';
  };
  const checkConsent = () => (field('waitlist-consent').checked ? '' : msg.consent);
  const checkBirth = () => {
    const [d, m, y] = parts.map((p) => p.value.trim());
    if (birthValue) birthValue.value = '';
    if (!d && !m && !y) return msg.required;
    if (!/^\d{1,2}$/.test(d) || !/^\d{1,2}$/.test(m) || !/^\d{4}$/.test(y)) return msg.date;
    const date = new Date(Number(y), Number(m) - 1, Number(d));
    const real = date.getFullYear() === Number(y) && date.getMonth() === Number(m) - 1 && date.getDate() === Number(d);
    if (!real || Number(y) < 1900 || date > new Date()) return msg.dateReal;
    if (birthValue) birthValue.value = `${y}-${m.padStart(2, '0')}-${d.padStart(2, '0')}`;
    return '';
  };

  // One row per field: its check, the inputs that carry aria-invalid, and the slot the message goes in.
  const rows = [
    { check: checkName, inputs: [field('waitlist-name')], slot: 'waitlist-name-error' },
    { check: checkEmail, inputs: [field('waitlist-email')], slot: 'waitlist-email-error' },
    { check: checkBirth, inputs: parts, slot: 'waitlist-birth-error' },
    { check: checkConsent, inputs: [field('waitlist-consent')], slot: 'waitlist-consent-error' },
  ];
  const show = (row: (typeof rows)[number]) => {
    const text = row.check();
    row.inputs.forEach((i) => (text ? i.setAttribute('aria-invalid', 'true') : i.removeAttribute('aria-invalid')));
    const slot = document.getElementById(row.slot);
    if (slot) slot.textContent = text;
    return text;
  };
  const rowOf = (t: EventTarget | null) => rows.find((r) => r.inputs.includes(t as HTMLInputElement));

  if (form) {
    // Digits only in the date parts, so a stray letter never reaches the check.
    // Typing the last digit of the day or month moves on to the next box.
    parts.forEach((p, i) =>
      p.addEventListener('input', (e) => {
        p.value = p.value.replace(/\D/g, '');
        const typed = (e as InputEvent).inputType?.startsWith('insert');
        if (typed && i < parts.length - 1 && p.value.length === p.maxLength) parts[i + 1].focus();
      })
    );

    // Validate a field when the user leaves it (the date as a group), and re-check live once it shows an error.
    form.addEventListener('focusout', (e) => {
      const row = rowOf(e.target);
      if (!row) return;
      const next = (e as FocusEvent).relatedTarget as Node | null;
      if (row.inputs.length > 1 && next && row.inputs.some((i) => i === next)) return;
      if (
        e.target instanceof HTMLInputElement &&
        e.target.type !== 'checkbox' &&
        !e.target.value &&
        !row.inputs.some((i) => i.value)
      )
        return;
      show(row);
    });
    form.addEventListener('input', (e) => {
      const row = rowOf(e.target);
      if (row && row.inputs.some((i) => i.getAttribute('aria-invalid'))) show(row);
    });
    form.addEventListener('change', (e) => {
      const row = rowOf(e.target);
      if (row && (e.target as HTMLInputElement).type === 'checkbox') show(row);
    });

    // TODO(client): replace with a real POST into the booking database. Until then a valid form only opens the
    // thank-you page, and nothing is stored.
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (form.dataset.sent !== undefined) return;
      const firstBad = rows.filter((r) => show(r))[0]; // show every error, focus the first
      if (firstBad) {
        firstBad.inputs.find((i) => !i.value || i.getAttribute('aria-invalid'))?.focus();
        return;
      }
      form.dataset.sent = '';
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]');
      btn?.setAttribute('aria-busy', 'true');
      btn?.setAttribute('aria-disabled', 'true');
      location.assign(form.dataset.thanks ?? '/');
    });
  }

  // The closing button takes a long-scrolling visitor back to the form.
  document.querySelector('[data-to-form]')?.addEventListener('click', (e) => {
    e.preventDefault();
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.getElementById('waitlist-form')?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    field('waitlist-name')?.focus({ preventScroll: true });
  });
</script>
