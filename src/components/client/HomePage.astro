---
import Page from '~/components/client/Page.astro';
import HomeHero from '~/components/client/home/HomeHero.astro';
import NextClasses from '~/components/client/home/NextClasses.astro';
import OfferTile from '~/components/client/home/OfferTile.astro';
import AboutStudio from '~/components/client/home/AboutStudio.astro';
import Rooms from '~/components/client/home/Rooms.astro';
import InstructorTeaser from '~/components/client/home/InstructorTeaser.astro';
import HowItWorks from '~/components/client/home/HowItWorks.astro';
import SculptBand from '~/components/client/home/SculptBand.astro';
import Faq from '~/components/client/home/Faq.astro';
import ContactBlock from '~/components/client/home/ContactBlock.astro';
import { getCopy } from '~/i18n';
import type { Lang } from '~/i18n';

interface Props {
  lang: Lang;
  /** Keeps the page out of search. */
  noindex?: boolean;
  twin?: Record<Lang, string>;
}

const { lang, noindex = false, twin } = Astro.props;
const copy = getCopy(lang).home;
---

<Page lang={lang} route="home" title={copy.title} description={copy.description} noindex={noindex} twin={twin}>
  <HomeHero lang={lang} />
  <NextClasses lang={lang} />
  <OfferTile lang={lang} />
  <AboutStudio lang={lang} />
  <Rooms lang={lang} />
  <InstructorTeaser lang={lang} />
  <HowItWorks lang={lang} />
  <SculptBand lang={lang} />
  <Faq lang={lang} />
  <ContactBlock lang={lang} />
</Page>
