---
import Page from '~/components/client/Page.astro';
import InstructorPhoto from '~/components/client/InstructorPhoto.astro';
import Placeholder from '~/components/client/Placeholder.astro';
import { instructors } from '~/data/instructors';
import { getCopy, instructorPath } from '~/i18n';
import type { Lang } from '~/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = getCopy(lang);
---

<Page lang={lang} route="instructors" title={copy.instructorsPage.title} description={copy.instructorsPage.description}>
  <section class="mx-auto max-w-7xl px-4 sm:px-6 py-12 md:py-16">
    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-heading">{copy.instructorsPage.title}</h1>
    <ul class="mt-10 grid grid-cols-2 gap-4 sm:gap-6 md:grid-cols-3 lg:grid-cols-4">
      {
        instructors.map((i) => {
          const line = i.line[lang];
          return (
            <li data-instructor={i.slug} class="flex flex-col gap-3">
              {/* The photo opens the same profile as the name, and stays out of the tab order and the accessibility tree, so the name is the one link announced. */}
              <a href={instructorPath(i.slug, lang)} tabindex="-1" aria-hidden="true" class="block">
                <InstructorPhoto slug={i.slug} first={i.first} role={copy.home.photo.instructor} />
              </a>
              <h2 class="text-xl font-bold text-heading">
                <a href={instructorPath(i.slug, lang)} class="hover:underline">
                  {i.first}
                </a>
              </h2>
              <p class="text-default">
                {line ?? (
                  <Placeholder
                    lang={lang}
                    label={
                      i.slug === 'domagoj'
                        ? 'Domagoj line, Dunia picks one of two alternatives (doc item 4)'
                        : `${i.first} line (doc item 4)`
                    }
                  />
                )}
              </p>
            </li>
          );
        })
      }
    </ul>
  </section>
</Page>
