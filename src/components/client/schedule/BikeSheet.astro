---
// The bike map dialog (ADR 0006: a visitor picks a class and bike before logging in). One native <dialog>, opened by
// the script below when the schedule list reports a press on Book (`schedule:book`). It follows the latest classes
// from `schedule:update`, so a bike that gets taken while it is open is dropped from the pick. Bottom sheet below sm,
// centred card from sm. Three steps: the map, a placeholder login, and a placeholder "booking opens soon" notice.
// The pick is kept in sessionStorage (class id, start time, bike) so it survives the login step and a reload, and
// the "your pick" bar on the page (ScheduleList.astro) offers it again. Opening, closing and the drag-to-dismiss are
// the prototype's sheet.js.
import { Icon } from 'astro-icon/components';
import Placeholder from '~/components/client/Placeholder.astro';
import { BIKE_COUNT, bikePosition } from '~/lib/bike-map';
import { getCopy } from '~/i18n';
import type { Lang } from '~/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getCopy(lang).bikeSheet;
const locale = lang === 'hr' ? 'hr-HR' : 'en-GB';
// DOM order is the reading order of the map (row by row, left to right), so Tab follows what the eye sees.
const bikes = Array.from({ length: BIKE_COUNT }, (_, i) => i + 1).sort((a, b) => {
  const [p, q] = [bikePosition(a), bikePosition(b)];
  return p.row - q.row || p.column - q.column;
});
const swatch = 'inline-block h-3.5 w-3.5 rounded border';
---

<dialog
  data-bike-sheet
  data-locale={locale}
  data-pick-text={t.pickBike}
  data-continue-text={t.continue}
  data-taken-text={t.taken_now}
  data-bike-text={t.bike}
  data-waitlist-text={t.waitlist}
  data-title-map={t.title}
  data-title-login={t.loginTitle}
  data-title-soon={t.soonTitle}
  aria-labelledby="bike-sheet-title"
  class="m-auto max-h-[85dvh] w-[min(100%,32.5rem)] max-w-[100vw] overflow-hidden overscroll-contain rounded-[1.25rem] border-0 bg-white p-0 text-default shadow-2xl backdrop:bg-black/40 backdrop:backdrop-blur-[6px] open:flex open:flex-col max-sm:m-0 max-sm:mt-auto max-sm:max-h-[calc(100dvh-env(safe-area-inset-top)-0.75rem)] max-sm:w-full max-sm:rounded-b-none dark:bg-slate-800"
>
  <div
    data-sheet-head
    class="sheet-head relative flex flex-none items-start justify-between gap-3 border-b border-gray-200 px-4 pb-3 pt-4 dark:border-slate-600 max-sm:pt-5"
  >
    <div class="min-w-0">
      <h2 id="bike-sheet-title" data-sheet-title class="font-heading text-lg font-bold text-heading">{t.title}</h2>
      <p data-sheet-meta class="mt-0.5 text-sm text-muted"></p>
    </div>
    <button
      type="button"
      data-sheet-close
      aria-label={t.close}
      class="-mr-1 -mt-1 inline-flex h-11 w-11 flex-none items-center justify-center rounded-full text-heading transition-colors duration-200 hover:bg-gray-100 dark:hover:bg-slate-700"
    >
      <Icon name="tabler:x" class="h-5 w-5" />
    </button>
  </div>

  <div data-step="map" class="flex min-h-0 flex-1 flex-col">
    <div class="min-h-0 flex-1 overflow-y-auto px-4 py-4">
      <div
        data-bike-grid
        class="mx-auto grid max-w-[22.5rem] grid-cols-[1fr_1fr_5.25rem] grid-rows-[repeat(5,auto)_0.875rem_repeat(5,auto)] gap-x-2 gap-y-1.5"
      >
        <ul class="col-start-3 row-span-3 row-start-1 flex flex-col gap-2 self-start pl-1.5 text-xs text-muted">
          <li class="inline-flex items-center gap-1.5">
            <i class:list={[swatch, 'border-heading bg-white dark:bg-slate-900']}></i>{t.free}
          </li>
          <li class="inline-flex items-center gap-1.5">
            <i class:list={[swatch, 'border-gray-200 bg-gray-200 dark:border-slate-600 dark:bg-slate-600']}></i>{
              t.taken
            }
          </li>
          <li class="inline-flex items-center gap-1.5">
            <i class:list={[swatch, 'border-primary bg-primary']}></i>{t.picked}
          </li>
        </ul>
        <p
          class="col-start-3 row-span-5 row-start-4 self-center rounded-lg border border-dashed border-gray-400 px-1 py-4 text-center text-[0.6875rem] font-semibold text-heading dark:border-slate-500"
        >
          <small class="mb-0.5 block text-[0.5625rem] font-normal uppercase tracking-wider text-muted"
            >{t.instructor}</small
          >
          <span data-sheet-instructor></span>
        </p>
        {
          bikes.map((n) => {
            const { column, row } = bikePosition(n);
            return (
              <button
                type="button"
                data-bike={n}
                aria-pressed="false"
                aria-label={t.bike.replace('{n}', String(n))}
                style={`grid-area: ${row} / ${column}`}
                class="min-h-11 sm:min-h-9 rounded-lg border border-heading transition-colors duration-200 bg-white font-heading text-sm font-bold text-heading hover:bg-gray-100 disabled:cursor-default disabled:border-gray-200 disabled:bg-gray-200 disabled:text-gray-600 disabled:hover:bg-gray-200 aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-white aria-pressed:hover:bg-primary dark:border-slate-400 dark:bg-slate-900 dark:text-white dark:hover:bg-slate-700 dark:disabled:border-slate-600 dark:disabled:bg-slate-600 dark:disabled:text-slate-300 dark:disabled:hover:bg-slate-600 dark:aria-pressed:border-primary dark:aria-pressed:bg-primary dark:aria-pressed:hover:bg-primary"
              >
                {n}
              </button>
            );
          })
        }
      </div>
    </div>

    <div
      class="flex flex-none flex-col gap-2 border-t border-gray-200 px-4 pb-[calc(0.75rem+env(safe-area-inset-bottom))] pt-3 dark:border-slate-600"
    >
      <p data-sheet-message role="status" aria-live="polite" class="min-h-5 text-sm text-default"></p>
      <button
        type="button"
        data-continue
        disabled
        class="btn-primary w-full disabled:cursor-default disabled:opacity-40 disabled:hover:border-primary disabled:hover:bg-primary"
      >
        {t.pickBike}
      </button>
    </div>
  </div>

  <div
    data-step="login"
    hidden
    class="min-h-0 flex-1 overflow-y-auto px-4 pb-[calc(1rem+env(safe-area-inset-bottom))] pt-4"
  >
    <p data-summary class="font-semibold text-heading"></p>
    <p class="mt-1 text-sm text-default">{t.loginIntro}</p>
    <form data-login-form class="mt-4 flex flex-col gap-3">
      <label class="flex flex-col gap-1 text-sm font-semibold text-heading">
        {t.email}
        <input
          type="email"
          required
          autocomplete="email"
          data-email
          data-autofocus
          class="min-h-11 rounded-lg border border-gray-400 bg-white px-3 text-base font-normal text-default dark:border-slate-500 dark:bg-slate-900"
        />
      </label>
      <button type="submit" data-send-code class="btn-primary w-full">{t.sendCode}</button>
    </form>
    <p class="mt-3"><Placeholder lang={lang} label="login is a placeholder until the booking app sign-in exists" /></p>
  </div>

  <div
    data-step="soon"
    hidden
    class="min-h-0 flex-1 overflow-y-auto px-4 pb-[calc(1rem+env(safe-area-inset-bottom))] pt-4"
  >
    <p data-summary class="font-semibold text-heading"></p>
    <p class="mt-1 text-default">{t.soonText}</p>
    <div class="mt-4 flex flex-col gap-2 sm:flex-row-reverse">
      <button type="button" data-back-to-schedule data-autofocus class="btn-primary w-full sm:w-auto">
        {t.backToSchedule}
      </button>
      <button type="button" data-change-bike class="btn-secondary w-full sm:w-auto">{t.changeBike}</button>
    </div>
    <p class="mt-3">
      <Placeholder lang={lang} label="booking opens soon is a placeholder until the booking app exists" />
    </p>
  </div>
</dialog>

<script>
  import { clearChoice, loadChoice, saveChoice } from '~/lib/booking-choice';
  import { STUDIO_ZONE } from '~/lib/schedule-days';
  import type { NextClass } from '~/lib/schedule-feed';
  import { fadeIn, fadeOut, pop, release } from '~/lib/motion.js';
  import { bindSheet, closeSheet, openSheet } from '~/lib/sheet.js';

  // The list script owns the classes and the feed. This script only listens, so the two share no state. The
  // listeners sit on document, which ClientRouter keeps, and the dialog is looked up when needed because a
  // navigation replaces it.
  type Step = 'map' | 'login' | 'soon';
  let classes: NextClass[] = [];
  let openId: string | null = null;
  let picked: number | null = null;
  let stepRun = 0;
  const bound = new WeakSet<HTMLElement>();

  const find = () => classes.find((c) => c.id === openId);
  const fill = (text: string | undefined, n: number) => (text ?? '').replace('{n}', String(n));
  const sheetEl = () => document.querySelector<HTMLDialogElement>('dialog[data-bike-sheet]');

  function when(locale: string | undefined, c: NextClass) {
    const day = new Intl.DateTimeFormat(locale, {
      weekday: 'short',
      day: 'numeric',
      month: 'numeric',
      timeZone: STUDIO_ZONE,
    });
    const time = new Intl.DateTimeFormat(locale, {
      hour: '2-digit',
      minute: '2-digit',
      hourCycle: 'h23',
      timeZone: STUDIO_ZONE,
    });
    const start = new Date(c.startsAt);
    return `${day.format(start)} \u00b7 ${time.format(start)}`;
  }

  function say(sheet: HTMLElement, text: string) {
    const el = sheet.querySelector<HTMLElement>('[data-sheet-message]')!;
    el.textContent = text;
    if (text) void fadeIn(el, 4, 200);
  }

  function showPick(sheet: HTMLElement) {
    const go = sheet.querySelector<HTMLButtonElement>('[data-continue]')!;
    go.disabled = picked === null;
    go.textContent = picked === null ? (sheet.dataset.pickText ?? '') : fill(sheet.dataset.continueText, picked);
  }

  // Updates the buttons in place (never rebuilds the grid, so focus stays). A picked bike that is now taken is dropped.
  function sync(sheet: HTMLElement) {
    const c = find();
    if (!c) return;
    let lost: number | null = null;
    const focused = document.activeElement; // disabling a button drops its focus, so note it first
    for (const b of sheet.querySelectorAll<HTMLButtonElement>('button[data-bike]')) {
      const n = Number(b.dataset.bike);
      b.disabled = n > c.capacity || c.takenBikes.includes(n);
      if (b.disabled && n === picked) lost = n;
      b.setAttribute('aria-pressed', String(!b.disabled && n === picked));
    }
    if (lost !== null) {
      picked = null;
      if (focused instanceof HTMLButtonElement && sheet.contains(focused) && focused.disabled)
        sheet.querySelector<HTMLButtonElement>('button[data-bike]:not(:disabled)')?.focus();
      say(sheet, fill(sheet.dataset.takenText, lost));
    }
    showPick(sheet);
  }

  const stepEls = (sheet: HTMLElement) => [...sheet.querySelectorAll<HTMLElement>('[data-step]')];

  function summarise(sheet: HTMLElement) {
    const text = picked === null ? sheet.dataset.waitlistText : fill(sheet.dataset.bikeText, picked);
    for (const el of sheet.querySelectorAll('[data-summary]')) el.textContent = text ?? '';
  }

  // Shows one step. Without `animate` (when the sheet opens) it just switches. Otherwise the old step fades out and
  // the new one fades in. A change that arrives mid-fade cancels the running one and wins.
  async function show(sheet: HTMLElement, step: Step, animate: boolean) {
    const run = ++stepRun;
    const steps = stepEls(sheet);
    const to = steps.find((s) => s.dataset.step === step)!;
    const from = steps.find((s) => !s.hidden && s !== to);
    for (const s of steps) s.getAnimations().forEach((a) => a.cancel());
    summarise(sheet);
    sheet.querySelector('[data-sheet-title]')!.textContent =
      sheet.dataset[`title${step[0].toUpperCase()}${step.slice(1)}`] ?? '';
    if (from && animate) {
      await fadeOut(from);
      if (run !== stepRun) return;
    }
    for (const s of steps) {
      s.hidden = s !== to;
      release(s);
    }
    if (animate) {
      void fadeIn(to);
      to.querySelector<HTMLElement>('[data-autofocus]')?.focus();
    }
  }

  function bind(sheet: HTMLDialogElement) {
    if (bound.has(sheet)) return;
    bound.add(sheet);
    bindSheet(sheet);
    sheet.querySelector('[data-sheet-close]')!.addEventListener('click', () => void closeSheet(sheet));
    sheet.querySelector('[data-bike-grid]')!.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('button[data-bike]');
      if (!b || b.disabled) return;
      picked = Number(b.dataset.bike);
      say(sheet, '');
      sync(sheet);
      void pop(b, 0.85);
    });
    sheet.querySelector('[data-continue]')!.addEventListener('click', () => {
      const c = find();
      if (!c || picked === null) return;
      saveChoice({ classId: c.id, startsAt: c.startsAt, bike: picked });
      refreshPending();
      void show(sheet, 'login', true);
    });
    // A placeholder: no code is sent, it only moves on to the notice.
    sheet.querySelector('[data-login-form]')!.addEventListener('submit', (e) => {
      e.preventDefault();
      void show(sheet, 'soon', true);
    });
    sheet.querySelector('[data-change-bike]')!.addEventListener('click', () => void show(sheet, 'map', true));
    sheet.querySelector('[data-back-to-schedule]')!.addEventListener('click', () => void closeSheet(sheet));
    // Back to where the visitor pressed Book, also when a feed refresh rebuilt that row meanwhile.
    sheet.addEventListener('close', () => {
      const id = openId;
      openId = null;
      if (id && (!document.activeElement || document.activeElement === document.body))
        document
          .querySelector<HTMLElement>(
            `li[data-class-id="${CSS.escape(id)}"] a, li[data-next-class="${CSS.escape(id)}"] a`
          )
          ?.focus();
    });
  }

  // Opens the sheet for a class. `bike` is the pick to start from (a kept one, or null) and `step` where to start.
  function openFor(c: NextClass, bike: number | null, step: Step) {
    const sheet = sheetEl();
    if (!sheet || sheet.open) return;
    bind(sheet);
    openId = c.id;
    picked = bike;
    say(sheet, '');
    const meta = `${when(sheet.dataset.locale, c)} \u00b7 ${c.instructor} \u00b7 ${c.themeName ?? c.name}`;
    sheet.querySelector('[data-sheet-meta]')!.textContent = meta;
    sheet.querySelector('[data-sheet-instructor]')!.textContent = c.instructor;
    sheet.querySelector<HTMLInputElement>('[data-email]')!.value = '';
    sync(sheet); // drops a kept bike that is taken now, and says so
    void show(sheet, step === 'login' && bike !== null && picked === null ? 'map' : step, false);
    openSheet(sheet);
  }

  // The "your pick" bar: shown when the kept choice is still valid and its class is in the feed.
  let barRun = 0;
  function refreshPending() {
    const bar = document.querySelector<HTMLElement>('[data-pending]');
    if (!bar) return;
    const choice = loadChoice();
    const c = choice && classes.find((x) => x.id === choice.classId);
    if (!choice || !c) {
      if (bar.hidden) return;
      const run = ++barRun;
      void fadeOut(bar).then(() => {
        if (run !== barRun) return;
        bar.hidden = true;
        release(bar);
      });
      return;
    }
    const label = `${when(bar.dataset.locale, c)} \u00b7 ${c.instructor}`;
    const template = choice.bike === null ? bar.dataset.waitlistText : bar.dataset.text;
    const text = fill((template ?? '').replace('{when}', label), choice.bike ?? 0);
    bar.querySelector('[data-pending-text]')!.textContent = text;
    barRun += 1;
    const wasHidden = bar.hidden;
    bar.getAnimations().forEach((a) => a.cancel());
    bar.hidden = false;
    if (wasHidden) void fadeIn(bar, -6, 200);
  }

  document.addEventListener('schedule:update', (e) => {
    classes = (e as CustomEvent<NextClass[]>).detail;
    const sheet = sheetEl();
    if (sheet?.open && openId) sync(sheet);
    refreshPending();
  });

  document.addEventListener('schedule:book', (e) => {
    const { classId, full } = (e as CustomEvent<{ classId: string; full: boolean }>).detail;
    const c = classes.find((x) => x.id === classId);
    if (!c) return;
    // A full class has no map to pick from: the waiting list goes straight to the login step.
    if (full) {
      saveChoice({ classId: c.id, startsAt: c.startsAt, bike: null });
      refreshPending();
      openFor(c, null, 'login');
    } else openFor(c, null, 'map');
  });

  document.addEventListener('click', (e) => {
    const hit = (e.target as Element).closest<HTMLElement>('[data-pending-continue], [data-pending-clear]');
    if (!hit) return;
    if (hit.hasAttribute('data-pending-clear')) {
      clearChoice();
      refreshPending();
      return;
    }
    const choice = loadChoice();
    const c = choice && classes.find((x) => x.id === choice.classId);
    if (!choice || !c) return refreshPending();
    const full = c.takenBikes.length >= c.capacity;
    // A kept bike that is taken now: back to the map with the message, or the waiting list when the class filled up.
    if (choice.bike !== null && full) saveChoice({ ...choice, bike: null });
    openFor(c, full ? null : choice.bike, 'login');
  });
</script>
