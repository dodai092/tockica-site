---
// One class on the schedule page, in the order the studio asked for: start time, instructor (initial mark, until
// portraits exist), training name, then how full it is and the action. The data-f fields are what the browser
// script fills when it clones this row from the feed (ScheduleList.astro). Below md the row is a rail (time left,
// action right); from md it stacks inside the day's sheet. With `card` it is the homepage card: always stacked, in
// its own box (NextClasses.astro).
import { TINTS, initialOf, tintIndex } from '~/lib/avatar';

interface Props {
  id: string;
  /** Start time only. */
  time: string;
  instructor: string;
  name: string;
  /** "2 left", "Full" and so on, already in the page language. */
  seatsText: string;
  /** How much of the room is taken, 0 to 100. */
  percent: number;
  /** Few places left: the seats text is highlighted. */
  scarce: boolean;
  /** No places: the waiting list is offered instead of Book. */
  full: boolean;
  href: string;
  labels: { book: string; waitlist: string };
  /** The homepage card: a box of its own, always stacked. Needs `freeBikes`. */
  card?: boolean;
  freeBikes?: number;
  /** Extra classes on the row, for the card's size in its list. */
  class?: string;
}

const {
  id,
  time,
  instructor,
  name,
  seatsText,
  percent,
  scarce,
  full,
  href,
  labels,
  card = false,
  freeBikes = 0,
} = Astro.props;
const flags = {
  ...(card ? { 'data-next-class': id, 'data-free-bikes': String(freeBikes) } : { 'data-class-id': id }),
  ...(full ? { 'data-full': '' } : {}),
  ...(scarce ? { 'data-scarce': '' } : {}),
};
---

<li
  {...flags}
  class:list={[
    'sched-row group',
    card
      ? 'sched-row--card rounded-(--aw-radius-card) border border-gray-200 bg-white p-3 shadow-xl sm:p-4 dark:border-slate-700 dark:bg-slate-900'
      : 'border-t border-gray-200 py-3.5 dark:border-slate-700',
    Astro.props.class,
  ]}
>
  <p data-f="time" class="[grid-area:time] self-start font-heading text-lg font-bold tabular-nums">
    {time}
  </p>
  <p
    class:list={[
      '[grid-area:who] flex min-w-0 items-center gap-2 font-semibold',
      card ? 'text-sm' : 'text-base md:text-sm',
    ]}
  >
    <span
      data-f="initial"
      aria-hidden="true"
      class:list={[
        'flex h-6 w-6 flex-none items-center justify-center rounded-full font-heading text-[0.625rem] font-bold',
        TINTS[tintIndex(instructor)],
      ]}>{initialOf(instructor)}</span
    >
    <span data-f="instructor" class="truncate">{instructor}</span>
  </p>
  <p data-f="name" class="[grid-area:kind] text-sm text-default">{name}</p>
  <div class="[grid-area:meter] mt-1 h-1 overflow-hidden rounded-full bg-gray-200 dark:bg-slate-700" aria-hidden="true">
    <div data-meter class="h-full rounded-full bg-(--aw-color-text-heading)" style={`width:${percent}%`}></div>
  </div>
  <p
    data-f="seats"
    class:list={[
      '[grid-area:seats] text-xs text-muted group-data-scarce:font-semibold group-data-scarce:text-primary dark:group-data-scarce:text-red-300',
      !card && 'md:justify-self-end',
    ]}
  >
    {seatsText}
  </p>
  <a
    href={href}
    class:list={[
      'sched-action [grid-area:action] inline-flex items-center whitespace-nowrap',
      card
        ? 'gap-1.5 pt-1 text-sm font-bold after:content-["→"]'
        : 'h-9 min-w-[6.5rem] justify-center rounded-full px-4 text-sm font-medium md:h-auto md:min-w-0 md:justify-start md:gap-1.5 md:rounded-none md:px-0 md:pt-1 md:font-bold md:after:content-["→"]',
      full
        ? !card && 'border border-gray-400 dark:border-slate-500 md:border-0'
        : card
          ? 'text-primary dark:text-red-300'
          : 'bg-primary text-white md:bg-transparent md:text-primary md:dark:text-red-300',
    ]}
  >
    {full ? labels.waitlist : labels.book}
  </a>
</li>

<style>
  .sched-row {
    display: grid;
    grid-template-columns: 3.25rem 1fr auto;
    grid-template-areas: 'time who action' 'time kind action' 'time meter action' 'time seats action';
    column-gap: 0.75rem;
    row-gap: 0.125rem;
    align-items: center;
  }
  @media (min-width: 768px) {
    .sched-row {
      grid-template-columns: 1fr auto;
      grid-template-areas: 'time seats' 'who who' 'kind kind' 'meter meter' 'action action';
      column-gap: 0.5rem;
      row-gap: 0.375rem;
    }
  }
  .sched-row.sched-row--card {
    grid-template-columns: 1fr;
    grid-template-areas: 'time' 'who' 'kind' 'meter' 'seats' 'action';
    row-gap: 0.375rem;
  }
  /* Press feedback like the site's buttons (animation-rules 4). Reduced motion keeps the colour change only. */
  .sched-action {
    transition: transform 0.35s var(--ease-spring);
  }
  .sched-action:active {
    transform: scale(0.96);
    transition-duration: 0.08s;
  }
  @media (prefers-reduced-motion: reduce) {
    .sched-action,
    .sched-action:active {
      transform: none;
      transition: none;
    }
  }
</style>
