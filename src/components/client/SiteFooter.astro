---
import Logo from '~/components/Logo.astro';
import { sculpt } from '~/data/sculpt';
import { footerRoutes } from '~/lib/nav';
import { getCopy, pathFor } from '~/i18n';
import type { Lang } from '~/i18n';

interface Props {
  lang: Lang;
  bookBarSpace?: boolean;
}

const { lang, bookBarSpace = false } = Astro.props;
const copy = getCopy(lang);

const nav = footerRoutes(sculpt.visible).map((key) => ({ text: copy.nav[key], href: pathFor(key, lang) }));
const legal = [
  { text: copy.footer.rules, href: pathFor('rules', lang) },
  { text: copy.footer.terms, href: pathFor('terms', lang) },
  { text: copy.footer.privacy, href: pathFor('privacy', lang) },
];
const social = [
  { text: 'Instagram', href: 'https://www.instagram.com/tockicanai' },
  { text: 'Facebook', href: 'https://www.facebook.com/tockicanai' },
  { text: 'TikTok', href: 'https://www.tiktok.com/@tockicanai' },
];
const linkClass = 'text-muted hover:text-default hover:underline transition duration-150 ease-in-out';
---

<footer class="relative border-t border-gray-200 dark:border-slate-700 not-prose">
  <div class:list={['max-w-7xl mx-auto px-4 sm:px-6 py-8 md:py-12', { 'pb-28 md:pb-12': bookBarSpace }]}>
    <div class="grid grid-cols-12 gap-8">
      <div class="col-span-12 lg:col-span-4">
        <a class="inline-block" href={pathFor('home', lang)}><Logo /></a>
        <p class="mt-4 text-sm text-muted">Točkica na i j.d.o.o. · OIB HR37892279693</p>
      </div>
      <nav class="col-span-6 lg:col-span-3" aria-label={lang === 'hr' ? 'Podnožje' : 'Footer'}>
        <ul class="text-sm space-y-2">
          {
            nav.map(({ text, href }) => (
              <li>
                <a class={linkClass} href={href}>
                  {text}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="col-span-6 lg:col-span-3">
        <ul class="text-sm space-y-2">
          {
            legal.map(({ text, href }) => (
              <li>
                <a class={linkClass} href={href}>
                  {text}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <ul class="col-span-12 lg:col-span-2 text-sm space-y-2">
        {
          social.map(({ text, href }) => (
            <li>
              <a class={linkClass} href={href} target="_blank" rel="noopener noreferrer">
                {text}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
