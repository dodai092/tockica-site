---
import { Picture } from 'astro:assets';
import Button from '~/components/ui/Button.astro';
import Placeholder from '~/components/client/Placeholder.astro';
import heroPhoto from '~/assets/images/placeholders/hero-riders-room.jpg';
import { getCopy, pathFor } from '~/i18n';
import type { Lang } from '~/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = getCopy(lang);
const schedule = pathFor('schedule', lang);
---

<section
  data-section="hero"
  class="relative isolate flex h-[clamp(440px,calc(100svh_-_70px),760px)] flex-col justify-end overflow-hidden bg-black text-white md:h-[clamp(600px,calc(100svh_-_115px),960px)]"
>
  <Picture
    src={heroPhoto}
    alt=""
    formats={['avif', 'webp']}
    widths={[768, 1280, 1600]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-[52%_40%]"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-black/45 via-black/15 to-black/85" aria-hidden="true"></div>
  <p class="absolute left-4 top-20 text-xs text-white/70 sm:left-6">
    <Placeholder lang={lang} label="hero photo is a placeholder from the Multisport deck, replace with a real photo" />
  </p>
  <div class="mx-auto w-full max-w-7xl px-4 pb-24 sm:px-6 md:pb-32">
    <h1 class="text-4xl font-extrabold tracking-tight md:text-6xl">Točkica na i</h1>
    <p class="mt-3 text-xl text-white/90"><Placeholder lang={lang} label="slogan (doc item 1)" /></p>
    <div class="mt-6 flex flex-wrap gap-3">
      <Button variant="primary" text={copy.cta.book} href={schedule} />
      <Button variant="secondary" text={copy.cta.seeSchedule} href={schedule} class="!text-white !border-white" />
    </div>
  </div>
</section>
