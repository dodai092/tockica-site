---
import Button from '~/components/ui/Button.astro';
import Photo from '~/components/client/Photo.astro';
import Placeholder from '~/components/client/Placeholder.astro';
import { getCopy, pathFor } from '~/i18n';
import type { Lang } from '~/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = getCopy(lang);
const schedule = pathFor('schedule', lang);
---

<section data-section="hero" class="mx-auto max-w-7xl px-4 sm:px-6 py-12 md:py-20">
  <div class="grid items-center gap-10 md:grid-cols-2">
    <div>
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-heading">Točkica na i</h1>
      <p class="mt-4 text-xl text-muted"><Placeholder lang={lang} label="slogan (doc item 1)" /></p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button variant="primary" text={copy.cta.book} href={schedule} />
        <Button variant="secondary" text={copy.cta.seeSchedule} href={schedule} />
      </div>
    </div>
    <Photo role={copy.home.photo.hero} ratio="4 / 3" />
  </div>
</section>
