---
import ContactDetails from '~/components/client/ContactDetails.astro';
import Photo from '~/components/client/Photo.astro';
import entrancePhoto from '~/assets/images/placeholders/entrance.jpg';
import { getCopy, pathFor } from '~/i18n';
import type { Lang } from '~/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = getCopy(lang).home.contact;
---

<section data-section="contact" class="mx-auto max-w-7xl px-4 sm:px-6 py-12 md:py-16">
  <h2 class="text-3xl font-extrabold text-heading">{copy.heading}</h2>
  <div class="mt-8 grid items-start gap-10 md:grid-cols-2">
    <ContactDetails lang={lang} />
    <Photo role="Fotka: ulaz u Riders Room" ratio="4 / 3" src={entrancePhoto} position="center 60%" />
  </div>
  <p class="mt-6"><a class="font-semibold underline" href={pathFor('contact', lang)}>{copy.write}</a></p>
</section>
