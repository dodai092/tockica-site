---
import Photo from '~/components/client/Photo.astro';
import receptionPhoto from '~/assets/images/placeholders/reception.jpg';
import { getCopy } from '~/i18n';
import type { Lang } from '~/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = getCopy(lang).home;
---

<section data-section="about" class="mx-auto max-w-7xl px-4 sm:px-6 py-12 md:py-16">
  <div class="grid items-center gap-10 md:grid-cols-2">
    <div>
      <h2 class="text-3xl font-extrabold text-heading">{copy.about.heading}</h2>
      <p class="mt-4 text-xl text-default">{copy.about.line}</p>
    </div>
    <Photo role={copy.photo.space} ratio="4 / 3" src={receptionPhoto} />
  </div>
</section>
