---
import InstructorPhoto from '~/components/client/InstructorPhoto.astro';
import { instructors, teaserSlugs } from '~/data/instructors';
import { getCopy, instructorPath, pathFor } from '~/i18n';
import type { Lang } from '~/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = getCopy(lang).home;
const teaser = teaserSlugs.map((slug) => instructors.find((i) => i.slug === slug)!);
---

<section data-section="instructors" class="mx-auto max-w-7xl px-4 sm:px-6 py-12 md:py-16">
  <h2 class="text-3xl font-extrabold text-heading">{copy.instructors.heading}</h2>
  <ul class="mt-8 grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4">
    {
      teaser.map((i) => (
        <li data-instructor={i.slug} class="flex flex-col gap-3">
          {/* The photo opens the same profile as the name, and stays out of the tab order and the accessibility tree, so the name is the one link announced. */}
          <a href={instructorPath(i.slug, lang)} tabindex="-1" aria-hidden="true" class="block">
            <InstructorPhoto slug={i.slug} first={i.first} role={copy.photo.instructor} />
          </a>
          <h3 class="text-xl font-bold text-heading">
            <a href={instructorPath(i.slug, lang)} class="hover:underline">
              {i.first}
            </a>
          </h3>
          <p class="text-default">{i.line[lang]}</p>
        </li>
      ))
    }
  </ul>
  <p class="mt-6"><a class="font-semibold underline" href={pathFor('instructors', lang)}>{copy.instructors.all}</a></p>
</section>
