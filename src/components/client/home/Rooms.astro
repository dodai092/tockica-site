---
import Photo from '~/components/client/Photo.astro';
import ridersPhoto from '~/assets/images/placeholders/hero-riders-room.jpg';
import { getCopy, pathFor } from '~/i18n';
import type { Lang } from '~/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = getCopy(lang);
const rooms = copy.home.rooms;
const cards = [
  {
    name: rooms.riders.name,
    text: rooms.riders.text,
    photo: copy.home.photo.riders,
    src: ridersPhoto,
    href: pathFor('schedule', lang),
    link: copy.cta.seeSchedule,
  },
  {
    name: rooms.sculpt.name,
    text: rooms.sculpt.text,
    photo: copy.home.photo.sculpt,
    href: pathFor('sculpt', lang),
    link: rooms.more,
  },
];
---

<section data-section="rooms" class="mx-auto max-w-7xl px-4 sm:px-6 py-12 md:py-16">
  <h2 class="text-3xl font-extrabold text-heading">{rooms.heading}</h2>
  <div class="mt-8 grid gap-8 md:grid-cols-2">
    {
      cards.map((c) => (
        <article class="flex flex-col gap-4">
          <Photo role={c.photo} ratio="3 / 2" src={c.src} />
          <h3 class="text-2xl font-bold text-heading">{c.name}</h3>
          <p class="text-default">{c.text}</p>
          <a class="font-semibold underline" href={c.href}>
            {c.link}
          </a>
        </article>
      ))
    }
  </div>
</section>
