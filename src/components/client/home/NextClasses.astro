---
import Placeholder from '~/components/client/Placeholder.astro';
import Button from '~/components/ui/Button.astro';
import { nextClasses } from '~/data/next-classes';
import { getCopy, pathFor } from '~/i18n';
import type { Lang } from '~/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = getCopy(lang).home.nextClasses;
const schedule = pathFor('schedule', lang);
const when = new Intl.DateTimeFormat(lang, {
  weekday: 'short',
  hour: '2-digit',
  minute: '2-digit',
  hourCycle: 'h23',
  timeZone: 'Europe/Zagreb',
});
---

<section data-section="next-classes" class="mx-auto max-w-7xl px-4 sm:px-6 py-12 md:py-16">
  <h2 class="text-3xl font-extrabold text-heading">{copy.heading}</h2>
  <p class="mt-3">
    <Placeholder lang={lang} label="next classes are mock data until the booking app endpoint exists" />
  </p>
  <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      nextClasses.map((c) => (
        <li
          data-next-class
          data-free-bikes={c.freeBikes}
          class="flex flex-col gap-3 rounded-(--aw-radius-card) border border-gray-200 dark:border-slate-600 p-5"
        >
          <p class="text-lg font-bold tabular-nums text-heading">{when.format(new Date(c.startsAt))}</p>
          <p class="text-default">
            {c.name}, {c.instructor}
          </p>
          <p class="text-sm text-muted">
            {copy.freeBikes}: <span class="font-semibold tabular-nums text-default">{c.freeBikes}</span>
          </p>
          <Button
            variant={c.freeBikes > 0 ? 'primary' : 'secondary'}
            text={c.freeBikes > 0 ? copy.book : copy.waitlist}
            href={schedule}
            class="mt-auto w-full"
          />
        </li>
      ))
    }
  </ul>
  <p class="mt-6"><a class="font-semibold underline" href={schedule}>{copy.all}</a></p>
</section>
