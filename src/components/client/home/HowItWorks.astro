---
import { getCopy } from '~/i18n';
import type { Lang } from '~/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = getCopy(lang).home.how;
---

<section data-section="how-it-works" class="mx-auto max-w-7xl px-4 sm:px-6 py-12 md:py-16">
  <h2 class="text-3xl font-extrabold text-heading">{copy.heading}</h2>
  <ol class="mt-8 grid gap-6 md:grid-cols-3">
    {
      copy.steps.map((step, i) => (
        <li
          data-step
          class="flex flex-col gap-2 rounded-(--aw-radius-card) border border-gray-200 dark:border-slate-600 p-6"
        >
          <span class="text-sm font-bold tabular-nums text-muted">{i + 1}</span>
          <h3 class="text-xl font-bold text-heading">{step.title}</h3>
          <p class="text-default">{step.text}</p>
        </li>
      ))
    }
  </ol>
</section>
