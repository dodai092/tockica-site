---
import Placeholder from '~/components/client/Placeholder.astro';
import { faq } from '~/data/faq';
import { getCopy } from '~/i18n';
import type { Lang } from '~/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = getCopy(lang).home.faq;
---

<section data-section="faq" class="mx-auto max-w-3xl px-4 sm:px-6 py-12 md:py-16">
  <h2 class="text-3xl font-extrabold text-heading">{copy.heading}</h2>
  <div class="mt-8 divide-y divide-gray-200 dark:divide-slate-600 border-y border-gray-200 dark:border-slate-600">
    {
      faq.map((item, i) => {
        const q = item.q[lang];
        const a = item.a[lang];
        return (
          <details data-faq-item class="group py-4">
            <summary class="cursor-pointer list-none text-lg font-semibold text-heading">
              {q ?? <Placeholder lang={lang} label={`FAQ question ${i + 1} (Croatian)`} />}
            </summary>
            <div class="mt-3 space-y-3 text-default">
              {a ? (
                a.split('\n').map((p) => <p>{p}</p>)
              ) : (
                <Placeholder
                  lang={lang}
                  label={i === 3 ? 'FAQ cancel answer (6-hour rule, Dunia approves)' : `FAQ answer ${i + 1} (Croatian)`}
                />
              )}
            </div>
          </details>
        );
      })
    }
  </div>
</section>
