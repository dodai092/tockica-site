---
// Colors and fonts come from the single per-client brand surface in `src/brand.ts`.
// Edit that file, not this one. See SETUP.md.
import { brand, type BrandTokens } from '~/brand';

const t: BrandTokens = brand.tokens ?? {};
const RADIUS = {
  sharp: { btn: '0', card: '0' },
  soft: { btn: '0.375rem', card: '0.5rem' },
  round: { btn: '0.625rem', card: '0.75rem' },
  pill: { btn: '9999px', card: '1rem' },
};
const SECTION = {
  tight: ['2.5rem', '3rem', '3.5rem'],
  normal: ['3rem', '4rem', '5rem'],
  roomy: ['4rem', '6rem', '8rem'],
};
const SHADOW = {
  none: '0 0 #0000',
  soft: '0 4px 30px rgb(0 0 0 / 0.08)',
  hard: '6px 6px 0 0 rgb(0 0 0 / 0.9)',
};
const CONTAINER = { narrow: '60rem', normal: '80rem', wide: '90rem' };

const radius = RADIUS[t.radius ?? 'soft'];
const section = SECTION[t.section ?? 'normal'];
const shadowCard = SHADOW[t.shadow ?? 'soft'];
const containerMax = CONTAINER[t.container ?? 'normal'];

const css = `
  :root {
    --aw-font-sans: ${brand.fonts.sans};
    --aw-font-serif: ${brand.fonts.serif};
    --aw-font-heading: ${brand.fonts.heading};

    --aw-color-primary: ${brand.light.primary};
    --aw-color-secondary: ${brand.light.secondary};
    --aw-color-accent: ${brand.light.accent};

    --aw-color-text-heading: ${brand.light.textHeading};
    --aw-color-text-default: ${brand.light.textDefault};
    --aw-color-text-muted: ${brand.light.textMuted};
    --aw-color-bg-page: ${brand.light.bgPage};

    --aw-color-bg-page-dark: ${brand.dark.bgPage};

    --aw-radius-btn: ${radius.btn};
    --aw-radius-card: ${radius.card};
    --aw-section-py-sm: ${section[0]};
    --aw-section-py-md: ${section[1]};
    --aw-section-py-lg: ${section[2]};
    --aw-shadow-card: ${shadowCard};
    --aw-container-max: ${containerMax};
    --aw-layout-page-max: var(--aw-container-max);
    --aw-layout-reading-max: 48rem;
    --aw-layout-media-max: 64rem;
    --aw-layout-grid-gap: 2rem;

    ::selection {
      background-color: lavender;
    }
  }

  .dark {
    --aw-font-sans: ${brand.fonts.sans};
    --aw-font-serif: ${brand.fonts.serif};
    --aw-font-heading: ${brand.fonts.heading};

    --aw-color-primary: ${brand.dark.primary};
    --aw-color-secondary: ${brand.dark.secondary};
    --aw-color-accent: ${brand.dark.accent};

    --aw-color-text-heading: ${brand.dark.textHeading};
    --aw-color-text-default: ${brand.dark.textDefault};
    --aw-color-text-muted: ${brand.dark.textMuted};
    --aw-color-bg-page: ${brand.dark.bgPage};

    ::selection {
      background-color: black;
      color: snow;
    }
  }
`;
---

<style is:inline set:html={css}></style>
