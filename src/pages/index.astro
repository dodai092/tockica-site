---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/client/Hero.astro';
import Note from '~/components/client/Note.astro';
import Features from '~/components/client/Features.astro';
import Steps from '~/components/client/Steps.astro';
import Content from '~/components/client/Content.astro';
import Testimonials from '~/components/client/Testimonials.astro';
import FAQs from '~/components/client/FAQs.astro';
import CallToAction from '~/components/client/CallToAction.astro';
import { getCollection } from 'astro:content';
import placeholderHero from '~/assets/images/placeholder-hero.svg';

const metadata = {
  title: 'Home',
  openGraph: { images: [{ url: '/og/home.png', width: 1200, height: 630 }] },
};

// Local SVG placeholder. Passed as an inline <img> string so the parts-bin
// widgets render it via their `typeof image === 'string'` branch and skip
// Sharp (SVG processing is disabled in this template's image config).
const heroImage = `<img src="${placeholderHero.src}" width="${placeholderHero.width}" height="${placeholderHero.height}" alt="" loading="eager" decoding="async" class="mx-auto w-full rounded-(--aw-radius-card) shadow-(--aw-shadow-card)" />`;

const testimonials = (await getCollection('testimonials')).map((t) => ({
  testimonial: t.data.quote,
  name: t.data.name,
  job: [t.data.role, t.data.company].filter(Boolean).join(', '),
}));

const faqs = (await getCollection('faqs'))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map((f) => ({ title: f.data.question, description: f.data.answer }));
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero actions={[{ variant: 'primary', text: 'Get in touch', href: '/contact' }]} image={heroImage}>
    <Fragment slot="title">
      <!-- REPLACE: a clear one-line statement of what the company does. Source: docs/intake.md -->
      A clear one-line statement of what the company does
    </Fragment>

    <Fragment slot="subtitle">
      <!-- REPLACE: one or two sentences on who this is for and the outcome they get. Source: docs/intake.md -->
      One or two plain sentences describing the offer and who it is for.
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <!-- REPLACE: a short statement of the company's approach. Source: docs/intake.md -->
  <Note title="Approach:" description="How we work, in one line." />

  <!-- Features Widget *************** -->

  <!-- REPLACE Features: subtitle and every item with the client's real offer. Source: docs/intake.md -->
  <Features
    id="features"
    title="What you get"
    subtitle="One sentence framing the list below."
    items={[
      {
        title: 'Feature one',
        description: 'REPLACE: describe one thing clients get. Source: docs/intake.md',
        icon: 'tabler:check',
      },
      {
        title: 'Feature two',
        description: 'REPLACE: describe one thing clients get. Source: docs/intake.md',
        icon: 'tabler:check',
      },
      {
        title: 'Feature three',
        description: 'REPLACE: describe one thing clients get. Source: docs/intake.md',
        icon: 'tabler:check',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    title="More detail"
    items={[
      {
        title: 'Point one',
        description: 'REPLACE: expand on one aspect of the offer. Source: docs/intake.md',
      },
      {
        title: 'Point two',
        description: 'REPLACE: expand on one aspect of the offer. Source: docs/intake.md',
      },
      {
        title: 'Point three',
        description: 'REPLACE: expand on one aspect of the offer. Source: docs/intake.md',
      },
    ]}
    image={heroImage}
  >
    <Fragment slot="content">
      <!-- REPLACE: a short paragraph on what sets the company apart. Source: docs/intake.md -->
      A short paragraph on what sets the company apart.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    title="How it works"
    items={[
      {
        title: 'Step 1',
        description: 'REPLACE: what happens first. Source: docs/intake.md',
        icon: 'tabler:number-1',
      },
      {
        title: 'Step 2',
        description: 'REPLACE: what happens next. Source: docs/intake.md',
        icon: 'tabler:number-2',
      },
      {
        title: 'Step 3',
        description: 'REPLACE: what happens last. Source: docs/intake.md',
        icon: 'tabler:number-3',
      },
    ]}
    image={heroImage}
  />

  <!-- Testimonials Widget *********** -->
  <!-- Renders from the `testimonials` collection; hidden when it is empty. -->

  {testimonials.length > 0 && <Testimonials title="What clients say" testimonials={testimonials} />}

  <!-- FAQs Widget ******************* -->
  <!-- Renders from the `faqs` collection; hidden when it is empty. -->

  {faqs.length > 0 && <FAQs title="Questions" items={faqs} />}

  <!-- CallToAction Widget *********** -->

  <CallToAction actions={[{ variant: 'primary', text: 'Get in touch', href: '/contact' }]}>
    <Fragment slot="title">
      <!-- REPLACE: a short closing line. Source: docs/intake.md -->
      Start a conversation
    </Fragment>

    <Fragment slot="subtitle">
      <!-- REPLACE: one sentence prompting the visitor to make contact. Source: docs/intake.md -->
      Tell us what you need and we will get back to you.
    </Fragment>
  </CallToAction>
</Layout>
