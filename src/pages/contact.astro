---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/client/HeroText.astro';
import ContactForm from '~/components/client/ContactForm.astro';
import Features2 from '~/components/client/Features2.astro';

const metadata = {
  title: 'Contact',
  openGraph: { images: [{ url: '/og/contact.png', width: 1200, height: 630 }] },
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Contact" title="Get in touch" subtitle="Send a message and we will reply." />

  <ContactForm />

  <!-- Features2 Widget ************** -->
  <!-- REPLACE Features2: every contact channel with the client's real details. Source: docs/intake.md -->

  <Features2
    title="Other ways to reach us"
    columns={3}
    items={[
      {
        title: 'Email',
        description: 'REPLACE: the real email address. Source: docs/intake.md',
        icon: 'tabler:mail',
      },
      {
        title: 'Phone',
        description: 'REPLACE: the real phone number. Source: docs/intake.md',
        icon: 'tabler:headset',
      },
      {
        title: 'Location',
        description: 'REPLACE: the real address. Source: docs/intake.md',
        icon: 'tabler:map-pin',
      },
    ]}
  />
</Layout>
