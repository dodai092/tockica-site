---
import Layout from '~/layouts/PageLayout.astro';
import { PAGES } from '~/pages/og/[...route]';

const metadata = {
  title: 'OG images',
  robots: { index: false, follow: false },
};

const keys = Object.keys(PAGES);
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-5xl px-4 py-12 space-y-8">
    <div>
      <h1 class="text-3xl font-bold">OG images</h1>
      <p class="text-muted">Generated social cards for this client. Dev preview, noindex.</p>
    </div>

    <div class="grid gap-8 sm:grid-cols-2">
      {
        keys.map((key) => (
          <figure class="space-y-2">
            <img
              src={`/og/${key}.png`}
              width="600"
              height="313"
              alt={`OG card for ${key}`}
              class="w-full border border-black/10"
            />
            <figcaption class="text-sm text-muted">
              /og/{key}.png · {PAGES[key].title}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>
</Layout>
