---
import Layout from '~/layouts/PageLayout.astro';
import { brand } from '~/brand';

const metadata = {
  title: 'Design tokens',
  robots: { index: false, follow: false },
};

const PANGRAM = 'The quick brown fox jumps over the lazy dog 0123';

const knobs = ['radius', 'button', 'section', 'shadow', 'container'] as const;
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-5xl px-4 py-12 space-y-16">
    <div>
      <h1 class="text-3xl font-bold">Design tokens</h1>
      <p class="text-muted">Resolved token system for this client. Dev preview, noindex.</p>
    </div>

    <!-- Colour -->
    <div>
      <h2 class="text-2xl font-bold mb-4">Colour</h2>
      {
        (['light', 'dark'] as const).map((mode) => (
          <div class="mb-6">
            <h3 class="font-semibold mb-2">brand.{mode}</h3>
            <div class="flex flex-wrap gap-4">
              {Object.entries(brand[mode]).map(([key, value]) => (
                <div class="text-xs">
                  <div class="w-16 h-16 border border-black/10" style={`background:${value}`} />
                  <div class="mt-1 font-medium">{key}</div>
                  <div class="text-muted">{value}</div>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <!-- Fonts -->
    <div>
      <h2 class="text-2xl font-bold mb-4">Fonts</h2>
      {
        (['sans', 'serif', 'heading'] as const).map((key) => (
          <p class="text-lg" style={`font-family:${brand.fonts[key]}`}>
            <span class="text-muted text-sm mr-2">
              {key} ({brand.fonts[key]}):
            </span>
            {PANGRAM}
          </p>
        ))
      }
    </div>

    <!-- Knobs -->
    <div>
      <h2 class="text-2xl font-bold mb-4">Knobs</h2>

      {
        knobs.map((knob) => (
          <div class="mb-10">
            <h3 class="font-semibold">
              {knob}: <code>{brand.tokens[knob]}</code>
            </h3>

            {knob === 'radius' && (
              <div class="mt-3 flex items-center gap-4">
                <button class="btn btn-primary">Button</button>
                <div class="border p-4" style="border-radius:var(--aw-radius-card)">
                  Card
                </div>
              </div>
            )}

            {knob === 'button' && (
              <div class="mt-3 flex items-center gap-4">
                <button class="btn btn-primary">Primary</button>
                <span class="text-muted text-sm">current mode: {brand.tokens.button}</span>
              </div>
            )}

            {knob === 'section' && (
              <div class="mt-3 space-y-2">
                <div class="bg-primary/20" style="height:var(--aw-section-py-md)" />
                <div class="bg-primary/20" style="height:var(--aw-section-py-md)" />
                <span class="text-muted text-sm">two bars at --aw-section-py-md</span>
              </div>
            )}

            {knob === 'shadow' && (
              <div
                class="mt-3 p-6 bg-white dark:bg-slate-800"
                style="box-shadow:var(--aw-shadow-card);border-radius:var(--aw-radius-card)"
              >
                Card with shadow
              </div>
            )}

            {knob === 'container' && (
              <div class="mt-3 w-full bg-black/5">
                <div class="mx-auto bg-primary/10 h-4" style="max-width:var(--aw-container-max)" />
                <span class="text-muted text-sm">
                  width ruler at --aw-container-max. Drives WidgetWrapper's default width (hero/text bands, Features3,
                  Note, Announcement, blog). Widgets that set their own containerClass (most
                  Features/Steps/Pricing/Contact/FAQs/Stats/ Testimonials/Brands/CallToAction) keep their hardcoded
                  width.
                </span>
              </div>
            )}
          </div>
        ))
      }
    </div>
  </section>
</Layout>
