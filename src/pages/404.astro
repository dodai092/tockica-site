---
// Croatian first (default language), one English line below. Netlify serves a single
// 404.html for every unknown path, including old WordPress URLs until redirects exist.
import Page from '~/components/client/Page.astro';
import { getCopy, pathFor } from '~/i18n';

const hr = getCopy('hr').notFound;
const en = getCopy('en').notFound;
---

<Page lang="hr" route="home" title={hr.title} description={hr.text} noindex>
  <section class="mx-auto max-w-3xl px-4 sm:px-6 py-16 md:py-24 text-center">
    <h1 class="text-heading font-extrabold tracking-tight">
      <span class="block text-8xl md:text-9xl" aria-hidden="true">404</span>
      <span class="mt-4 block text-3xl md:text-4xl">{hr.title}</span>
    </h1>
    <p class="mt-4 text-xl text-default">{hr.text}</p>
    <p class="mt-8"><a class="btn-primary" href={pathFor('home', 'hr')}>{hr.back}</a></p>
    <p lang="en" class="mt-10 text-muted">
      {en.title}. <a class="font-semibold underline" href={pathFor('home', 'en')}>{en.back}</a>
    </p>
  </section>
</Page>
