---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/client/HeroText.astro';
import Prices from '~/components/client/Pricing.astro';
import FAQs from '~/components/client/FAQs.astro';
import CallToAction from '~/components/client/CallToAction.astro';
import { getCollection } from 'astro:content';

const metadata = {
  title: 'Pricing',
  openGraph: { images: [{ url: '/og/pricing.png', width: 1200, height: 630 }] },
};

const faqs = (await getCollection('faqs'))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map((f) => ({ title: f.data.question, description: f.data.answer }));
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <!-- REPLACE HeroText: title and subtitle with the client's pricing framing. Source: docs/intake.md -->
  <HeroText tagline="Pricing" title="Pricing" subtitle="Plans and what each one includes." />

  <!-- Pricing Widget ******************* -->
  <!-- REPLACE Prices: every tier name, price, period, and feature line. Source: docs/intake.md -->

  <Prices
    title="Plans"
    subtitle="Pick the plan that fits the work."
    prices={[
      {
        title: 'Starter',
        subtitle: 'REPLACE: who this tier is for',
        price: 0, // REPLACE with the real price. Source: docs/intake.md
        period: 'per project',
        items: [{ description: 'REPLACE: what is included' }, { description: 'REPLACE: what is included' }],
        callToAction: { text: 'Get in touch', href: '/contact' },
      },
      {
        title: 'Standard',
        subtitle: 'REPLACE: who this tier is for',
        price: 0, // REPLACE with the real price. Source: docs/intake.md
        period: 'per project',
        items: [
          { description: 'REPLACE: what is included' },
          { description: 'REPLACE: what is included' },
          { description: 'REPLACE: what is included' },
        ],
        callToAction: { text: 'Get in touch', href: '/contact' },
        hasRibbon: true,
        ribbonTitle: 'popular',
      },
      {
        title: 'Full',
        subtitle: 'REPLACE: who this tier is for',
        price: 0, // REPLACE with the real price. Source: docs/intake.md
        period: 'per project',
        items: [
          { description: 'REPLACE: what is included' },
          { description: 'REPLACE: what is included' },
          { description: 'REPLACE: what is included' },
        ],
        callToAction: { text: 'Get in touch', href: '/contact' },
      },
    ]}
  />

  <!-- FAQs Widget ******************* -->
  <!-- Renders from the `faqs` collection; hidden when it is empty. -->

  {faqs.length > 0 && <FAQs title="Pricing questions" columns={1} items={faqs} />}

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="Not sure which plan fits?"
    subtitle="Tell us about the project and we will point you to the right one."
    actions={[{ variant: 'primary', text: 'Get in touch', href: '/contact' }]}
  />
</Layout>
