---
import Features2 from '~/components/client/Features2.astro';
import Features3 from '~/components/client/Features3.astro';
import Hero from '~/components/client/Hero.astro';
import Steps2 from '~/components/client/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import placeholderHero from '~/assets/images/placeholder-hero.svg';

const metadata = {
  title: 'About',
  openGraph: { images: [{ url: '/og/about.png', width: 1200, height: 630 }] },
};

// Local SVG placeholder, passed as an inline <img> string so the widget skips
// Sharp (SVG processing is disabled in this template's image config).
const heroImage = `<img src="${placeholderHero.src}" width="${placeholderHero.width}" height="${placeholderHero.height}" alt="" loading="eager" decoding="async" class="mx-auto w-full rounded-(--aw-radius-card) shadow-(--aw-shadow-card)" />`;

const team = (await getCollection('team')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero tagline="About" image={heroImage}>
    <Fragment slot="title">
      <!-- REPLACE: a one-line summary of who the company is. Source: docs/intake.md -->
      Who we are
    </Fragment>

    <Fragment slot="subtitle">
      <!-- REPLACE: two or three sentences on the company's background and focus. Source: docs/intake.md -->
      A short background on the company and what it focuses on.
    </Fragment>
  </Hero>

  <!-- Features3 Widget ************** -->

  <!-- REPLACE Features3: title, subtitle and every value with the client's real values. Source: docs/intake.md -->
  <Features3
    title="Our values"
    subtitle="One sentence on what guides the work."
    columns={3}
    items={[
      {
        title: 'Value one',
        description: 'REPLACE: describe one value. Source: docs/intake.md',
        icon: 'tabler:check',
      },
      {
        title: 'Value two',
        description: 'REPLACE: describe one value. Source: docs/intake.md',
        icon: 'tabler:check',
      },
      {
        title: 'Value three',
        description: 'REPLACE: describe one value. Source: docs/intake.md',
        icon: 'tabler:check',
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <!-- REPLACE Steps2: title, subtitle and every step with the client's real process. Source: docs/intake.md -->
  <Steps2
    title="How we work"
    subtitle="One sentence on the way engagements run."
    items={[
      {
        title: 'Step one',
        description: 'REPLACE: what happens first. Source: docs/intake.md',
      },
      {
        title: 'Step two',
        description: 'REPLACE: what happens next. Source: docs/intake.md',
      },
      {
        title: 'Step three',
        description: 'REPLACE: what happens last. Source: docs/intake.md',
      },
    ]}
  />

  <!-- Team section ****************** -->
  <!-- Renders from the `team` collection; hidden when it is empty. -->

  {
    team.length > 0 && (
      <Features2
        title="Team"
        columns={2}
        items={team.map((p) => ({
          title: p.data.name,
          description: `${p.data.role}. ${p.data.bio ?? ''}`.trim(),
        }))}
      />
    )
  }
</Layout>
